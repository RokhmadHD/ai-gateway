# Connection string for Postgres.
#
# - Saat dijalankan dari host (pnpm db:migrate, dst.):
#     DATABASE_URL=postgres://ai_gateway:ai_gateway_dev@localhost:5433/ai_gateway
# - Saat dijalankan via `docker compose run --rm db-tools ...`:
#     DATABASE_URL sudah di-set otomatis di docker-compose.yml
#     (postgres://...@postgres:5432/ai_gateway)
#
# File ini hanya dipakai workflow host. Edit kalau perlu.

DATABASE_URL=postgres://ai_gateway:ai_gateway_dev@localhost:5433/ai_gateway
