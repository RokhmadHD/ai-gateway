{
  "name": "@ai-gateway/shared",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./crypto": {
      "types": "./src/crypto.ts",
      "default": "./dist/crypto.js"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./dist/errors.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.7.2"
  }
}
