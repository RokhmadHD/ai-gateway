PORT=3000
HOST=0.0.0.0
PRETTY_LOGS=1

# Provider API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Default provider: openai | anthropic
DEFAULT_PROVIDER=openai

# Gemini OAuth (optional, for Gemini provider)
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=

# ─── Auth (S6) ───
# Random secret for session signing — generate via `openssl rand -hex 32`
BETTER_AUTH_SECRET=
# Public origin of the admin server (must match dashboard fetch target)
BETTER_AUTH_URL=http://localhost:7780
# Comma-separated origins allowed to send credentialed requests (dashboard URLs)
CORS_ORIGIN=http://localhost:7782,http://localhost:3000

# Social OAuth — leave blank to disable that provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Bootstrap owner user created by `pnpm db:seed` (skip if blank)
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Legacy admin bearer fallback — set to 1 only during migration from S5
LEGACY_ADMIN_TOKEN_FALLBACK=0
