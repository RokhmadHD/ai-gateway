{
  "name": "@ai-gateway/proxy",
  "version": "0.1.0",
  "private": true,
  "description": "AI Gateway data-plane — Fastify proxy with key rotation + provider routing",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-gateway/config-runtime": "workspace:*",
    "@ai-gateway/db": "workspace:*",
    "@ai-gateway/shared": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "drizzle-orm": "^0.36.4",
    "fastify": "^4.28.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.3",
    "smol-toml": "^1.6.1",
    "socks": "^2.8.9",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
